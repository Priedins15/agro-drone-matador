       y = -motorY,
       z = motorZ,
       global = true,
     )
frontRightVents = patternCircular3d(
  frontRightVentSeed,
  instances = 12,
  axis = Z,
  center = [motorX, -motorY, motorZ + 4mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
frontLeftVentSeed = clone(ventFinSeed)
  |> translate(
       x = -motorX,
       y = -motorY,
       z = motorZ,
       global = true,

  frontRightBell,
  frontLeftBell,
  rearRightBell,
  rearLeftBell,
  frontRightTopCap,
  frontLeftTopCap,
  rearRightTopCap,
  rearLeftTopCap,
  frontRightBase,
  frontLeftBase,
  rearRightBase,
  rearLeftBase,
  frontRightMountPlate,
  frontLeftMountPlate,
  rearRightMountPlate,
  rearLeftMountPlate,
  frontRightStator,
  frontLeftStator,
  rearRightStator,
  rearLeftStator,
  frontRightWindings,
  frontLeftWindings,
  rearRightWindings,
  rearLeftWindings,
  frontRightShaft,
  frontLeftShaft,
  rearRightShaft,
  rearLeftShaft,
  frontRightLowerBearing,
  frontLeftLowerBearing,
  rearRightLowerBearing,
  rearLeftLowerBearing,
  frontRightUpperBearing,
  frontLeftUpperBearing,
  rearRightUpperBearing,
  rearLeftUpperBearing,
  frontRightAdapter,
  frontLeftAdapter,
  rearRightAdapter,
  rearLeftAdapter,
  frontRightNut,
  frontLeftNut,
  rearRightNut,

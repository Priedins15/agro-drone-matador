       global = true,
     )
rearRightMountPlate = clone(motorMountPlate)
  |> translate(
       x = motorX,
       y = motorY,
       z = motorZ,
       global = true,
     )
rearLeftMountPlate = clone(motorMountPlate)
  |> translate(
       x = -motorX,
       y = motorY,
       z = motorZ,
       global = true,
     )

frontRightStator = clone(statorCore)
  |> translate(
       x = motorX,
       y = -motorY,
       z = motorZ,
       global = true,
     )
frontLeftStator = clone(statorCore)
  |> translate(
       x = -motorX,
       y = -motorY,
       z = motorZ,
       global = true,
     )
rearRightStator = clone(statorCore)
  |> translate(
       x = motorX,
       y = motorY,
       z = motorZ,

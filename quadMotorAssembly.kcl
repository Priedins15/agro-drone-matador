       z = motorZ,
       global = true,
     )
rearRightBase = clone(lowerMotorBase)
  |> translate(
       x = motorX,
       y = motorY,
       z = motorZ,
       global = true,
     )
rearLeftBase = clone(lowerMotorBase)
  |> translate(
       x = -motorX,
       y = motorY,
       z = motorZ,
       global = true,
     )

frontRightMountPlate = clone(motorMountPlate)
  |> translate(

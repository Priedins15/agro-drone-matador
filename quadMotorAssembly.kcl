frontRightCoilSeed = clone(coilSeed)
  |> translate(
       x = motorX,
       y = -motorY,
       z = motorZ,
       global = true,
     )
frontRightWindings = patternCircular3d(
  frontRightCoilSeed,
  instances = 12,
  axis = Z,
  center = [motorX, -motorY, motorZ - 6mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
frontLeftCoilSeed = clone(coilSeed)
  |> translate(
       x = -motorX,
       y = -motorY,
       z = motorZ,
       global = true,
     )
frontLeftWindings = patternCircular3d(
  frontLeftCoilSeed,
  instances = 12,
  axis = Z,
  center = [-motorX, -motorY, motorZ - 6mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
rearRightCoilSeed = clone(coilSeed)
  |> translate(
       x = motorX,
       y = motorY,
       z = motorZ,
       global = true,
     )
rearRightWindings = patternCircular3d(

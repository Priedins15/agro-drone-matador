// Four-motor propulsion subassembly
// Independently instanced detailed motor components at the four arm-end datums.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import motorBell, bellTopCap, lowerMotorBase, motorMountPlate, statorCore, coilSeed, motorShaft, lowerBearing, upperBearing, propAdapter, propRetainingNut, ventFinSeed, mountScrewSeed from "motorModule.kcl"
import * from "parameters.kcl"

frontRightBell = clone(motorBell)
  |> translate(
       x = motorX,
       y = -motorY,
       z = motorZ,
       global = true,
     )
frontLeftBell = clone(motorBell)
  |> translate(
       x = -motorX,
       y = -motorY,
       z = motorZ,
       global = true,
     )
rearRightBell = clone(motorBell)
  |> translate(
       x = motorX,
       y = motorY,
       z = motorZ,
       global = true,
     )
rearLeftBell = clone(motorBell)
  |> translate(
       x = -motorX,
       y = motorY,
       z = motorZ,
       global = true,
     )

frontRightTopCap = clone(bellTopCap)
  |> translate(
       x = motorX,
       y = -motorY,
       z = motorZ,
       global = true,
     )
frontLeftTopCap = clone(bellTopCap)
  |> translate(
       x = -motorX,
       y = -motorY,
       z = motorZ,
       global = true,
     )
rearRightTopCap = clone(bellTopCap)
  |> translate(
       x = motorX,
       y = motorY,
       z = motorZ,
       global = true,
     )
rearLeftTopCap = clone(bellTopCap)
  |> translate(
       x = -motorX,
       y = motorY,
       z = motorZ,
       global = true,

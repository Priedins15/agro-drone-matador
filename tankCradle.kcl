frontRightLowerPostHole = clone(frontLeftLowerPostHole)
  |> translate(x = 224mm, global = true)
frontRightUpperPostHole = clone(frontLeftUpperPostHole)
  |> translate(x = 224mm, global = true)
rearLeftLowerPostHole = clone(frontLeftLowerPostHole)

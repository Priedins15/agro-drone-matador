// Structural tank cradle assembly
// Receiver-connected perimeter rails, lower cage, compliant tank pads, hangers, and transverse fasteners.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import unitBlock from "unitBlock.kcl"
import unitCylinder from "unitCylinder.kcl"
import lowerReceiver from "tankCradleLowerReceiver.kcl"
import upperReceiver from "tankCradleUpperReceiver.kcl"
import cornerReceiver from "tankCradleCornerReceiver.kcl"
import * from "parameters.kcl"

leftRailBlank = clone(unitBlock)
  |> scale(
       x = 18,
       y = 238,
       z = 22,
       global = false,
     )
  |> translate(x = -112mm, z = 18mm, global = true)
rightRailBlank = clone(leftRailBlank)
  |> translate(x = 224mm, global = true)
frontCrossTieBlank = clone(unitBlock)
  |> scale(
       x = 224,
       y = 8,
       z = 22,
       global = false,
     )
  |> translate(y = -119mm, z = 18mm, global = true)
rearCrossTieBlank = clone(frontCrossTieBlank)
  |> translate(y = 238mm, global = true)
frontBottomCrossmemberBlank = clone(unitBlock)
  |> scale(
       x = 224,
       y = 18,
       z = 10,
       global = false,
     )
  |> translate(y = -24mm, z = -128mm, global = true)
rearBottomCrossmemberBlank = clone(frontBottomCrossmemberBlank)
  |> translate(y = 48mm, global = true)

frontLeftLowerLegBlank = clone(unitBlock)
  |> scale(
       x = 14,
       y = 14,
       z = 135,
       global = false,
     )
  |> translate(
       x = -112mm,
       y = -24mm,
       z = -60.5mm,
       global = true,
     )
frontRightLowerLegBlank = clone(frontLeftLowerLegBlank)
  |> translate(x = 224mm, global = true)
rearLeftLowerLegBlank = clone(frontLeftLowerLegBlank)
  |> translate(y = 48mm, global = true)
rearRightLowerLegBlank = clone(frontRightLowerLegBlank)
  |> translate(y = 48mm, global = true)

frontLeftUpperRailHole = clone(unitCylinder)
  |> scale(
       x = 5.8,
       y = 5.8,
       z = 34,
       global = false,
     )
  |> rotate(axis = Y, angle = 90deg, global = true)
  |> translate(
       x = -112mm,
       y = -24mm,
       z = 18mm,
       global = true,
     )
rearLeftUpperRailHole = clone(frontLeftUpperRailHole)
  |> translate(y = 48mm, global = true)
frontRightUpperRailHole = clone(frontLeftUpperRailHole)
  |> translate(x = 224mm, global = true)
rearRightUpperRailHole = clone(frontRightUpperRailHole)
  |> translate(y = 48mm, global = true)
frontLeftCornerRailHole = clone(unitCylinder)
  |> scale(
       x = 5.8,
       y = 5.8,
       z = 34,
       global = false,
     )
  |> translate(
       x = -112mm,
       y = -97mm,
       z = 18mm,
       global = true,
     )
rearLeftCornerRailHole = clone(frontLeftCornerRailHole)
  |> translate(y = 194mm, global = true)
frontRightCornerRailHole = clone(frontLeftCornerRailHole)
  |> translate(x = 224mm, global = true)
rearRightCornerRailHole = clone(frontRightCornerRailHole)
  |> translate(y = 194mm, global = true)
leftRail = leftRailBlank - frontLeftUpperRailHole - rearLeftUpperRailHole - frontLeftCornerRailHole - rearLeftCornerRailHole
  |> appearance(color = hardwareBlack, metalness = 72, roughness = 38)
rightRail = rightRailBlank - frontRightUpperRailHole - rearRightUpperRailHole - frontRightCornerRailHole - rearRightCornerRailHole
  |> appearance(color = hardwareBlack, metalness = 72, roughness = 38)

frontLeftCrossTieHole = clone(unitCylinder)
  |> scale(
       x = 5.8,
       y = 5.8,
       z = 34,
       global = false,
     )
  |> translate(
       x = -90mm,
       y = -119mm,
       z = 18mm,
       global = true,
     )
frontRightCrossTieHole = clone(frontLeftCrossTieHole)
  |> translate(x = 180mm, global = true)
rearLeftCrossTieHole = clone(frontLeftCrossTieHole)
  |> translate(y = 238mm, global = true)
rearRightCrossTieHole = clone(frontRightCrossTieHole)
  |> translate(y = 238mm, global = true)
frontCrossTie = frontCrossTieBlank - frontLeftCrossTieHole - frontRightCrossTieHole
  |> appearance(color = hardwareBlack, metalness = 72, roughness = 38)
rearCrossTie = rearCrossTieBlank - rearLeftCrossTieHole - rearRightCrossTieHole
  |> appearance(color = hardwareBlack, metalness = 72, roughness = 38)

frontLeftBottomCrossHole = clone(unitCylinder)
  |> scale(
       x = 5.8,
       y = 5.8,
       z = 34,
       global = false,
     )
  |> rotate(axis = X, angle = 90deg, global = true)
  |> translate(
       x = -91mm,
       y = -24mm,
       z = -128mm,
       global = true,
     )
frontRightBottomCrossHole = clone(frontLeftBottomCrossHole)
  |> translate(x = 182mm, global = true)
rearLeftBottomCrossHole = clone(frontLeftBottomCrossHole)
  |> translate(y = 48mm, global = true)
rearRightBottomCrossHole = clone(frontRightBottomCrossHole)
  |> translate(y = 48mm, global = true)
frontBottomCrossmember = frontBottomCrossmemberBlank - frontLeftBottomCrossHole - frontRightBottomCrossHole
  |> appearance(color = hardwareBlack, metalness = 72, roughness = 38)
rearBottomCrossmember = rearBottomCrossmemberBlank - rearLeftBottomCrossHole - rearRightBottomCrossHole
  |> appearance(color = hardwareBlack, metalness = 72, roughness = 38)

frontLeftLowerPostHole = clone(unitCylinder)
  |> scale(
       x = 5.8,

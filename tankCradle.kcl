frontLeftLowerReceiver = clone(lowerReceiver)
  |> translate(
       x = -112mm,
       y = -24mm,
       z = -128mm,
       global = true,
     )
frontRightLowerReceiver = clone(lowerReceiver)
  |> rotate(axis = Z, angle = 180deg, global = true)

rearRightLowerPostHole = clone(frontRightLowerPostHole)
  |> translate(y = 48mm, global = true)
rearRightUpperPostHole = clone(frontRightUpperPostHole)
  |> translate(y = 48mm, global = true)
frontLeftLowerLeg = frontLeftLowerLegBlank - frontLeftLowerPostHole - frontLeftUpperPostHole

       z = 34,
       global = false,
     )
  |> rotate(axis = Y, angle = 90deg, global = true)
  |> translate(
       x = -112mm,
       y = -24mm,
       z = -107mm,
       global = true,
     )
frontLeftUpperPostHole = clone(frontLeftLowerPostHole)

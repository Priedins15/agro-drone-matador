       x = -91mm,
       y = -24mm,
       z = -128mm,
       global = true,
     )
  |> appearance(color = hardwareBlack, metalness = 90, roughness = 22)
frontLowerCrossBoltShafts = patternLinear3d(
  lowerCrossBoltSeed,
  instances = 2,
  distance = 182mm,
  axis = X,
)
rearLowerCrossBoltSeed = clone(lowerCrossBoltSeed)
  |> translate(y = 48mm, global = true)
rearLowerCrossBoltShafts = patternLinear3d(
  rearLowerCrossBoltSeed,
  instances = 2,
  distance = 182mm,
  axis = X,
)

       x = 112mm,
       y = -24mm,
       z = -128mm,
       global = true,
     )
rearLeftLowerReceiver = clone(frontLeftLowerReceiver)
  |> translate(y = 48mm, global = true)
rearRightLowerReceiver = clone(frontRightLowerReceiver)
  |> translate(y = 48mm, global = true)
frontLeftUpperReceiver = clone(upperReceiver)
  |> translate(
       x = -112mm,
       y = -24mm,
       z = 7mm,
       global = true,
     )
frontRightUpperReceiver = clone(upperReceiver)
  |> translate(
       x = 112mm,
       y = -24mm,
       z = 7mm,
       global = true,
     )
rearLeftUpperReceiver = clone(frontLeftUpperReceiver)
  |> translate(y = 48mm, global = true)
rearRightUpperReceiver = clone(frontRightUpperReceiver)
  |> translate(y = 48mm, global = true)
frontLeftCornerReceiver = clone(cornerReceiver)
  |> translate(
       x = -112mm,
       y = -119mm,
       z = 18mm,
       global = true,
     )
frontRightCornerReceiver = mirror3d([cornerReceiver], across = YZ)
  |> translate(
       x = 112mm,
       y = -119mm,
       z = 18mm,
       global = true,
     )
rearLeftCornerReceiver = mirror3d([cornerReceiver], across = XZ)
  |> translate(
       x = -112mm,
       y = 119mm,
       z = 18mm,
       global = true,
     )
rearRightCornerReceiver = clone(cornerReceiver)
  |> rotate(axis = Z, angle = 180deg, global = true)
  |> translate(
       x = 112mm,
       y = 119mm,
       z = 18mm,
       global = true,
     )

lowerCrossBoltSeed = clone(unitCylinder)

// Four-nozzle spray assembly with driven rotary sprinkler heads
// Detailed anti-drip nozzle sets, fluid riser interfaces, and three-jet rotor stations.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import valveBody, inletBarb, barbRingSeed, strainerCup, meshDisk, tipHolder, orificePlate, deflector, sprinklerDriveSpindle, sprinklerUpperBearing, sprinklerLowerBearing, sprinklerRotorHub, sprinklerRotorArmSeed, sprinklerJetSeed, sprinklerJetCapSeed from "sprayNozzle.kcl"
import * from "parameters.kcl"

frontRightRings = patternLinear3d(
  clone(barbRingSeed),
  instances = 4,
  distance = 9mm,
  axis = Z,
)
frontRightRotorArms = patternCircular3d(
  clone(sprinklerRotorArmSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
frontRightJets = patternCircular3d(
  clone(sprinklerJetSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
frontRightJetCaps = patternCircular3d(
  clone(sprinklerJetCapSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
frontRightNozzle = flatten([
  clone(valveBody),
  clone(inletBarb),
  frontRightRings,
  clone(strainerCup),
  clone(meshDisk),
  clone(tipHolder),
  clone(orificePlate),
  clone(deflector),
  clone(sprinklerDriveSpindle),
  clone(sprinklerUpperBearing),
  clone(sprinklerLowerBearing),
  clone(sprinklerRotorHub),
  frontRightRotorArms,
  frontRightJets,
  frontRightJetCaps
])
  |> rotate(axis = Z, angle = 10deg, global = true)
  |> translate(
       x = nozzleX,
       y = -nozzleY,
       z = nozzleZ,
       global = true,
     )

frontLeftRings = patternLinear3d(
  clone(barbRingSeed),
  instances = 4,
  distance = 9mm,
  axis = Z,
)
frontLeftRotorArms = patternCircular3d(
  clone(sprinklerRotorArmSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
frontLeftJets = patternCircular3d(
  clone(sprinklerJetSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
frontLeftJetCaps = patternCircular3d(
  clone(sprinklerJetCapSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
frontLeftNozzle = flatten([
  clone(valveBody),
  clone(inletBarb),
  frontLeftRings,
  clone(strainerCup),
  clone(meshDisk),
  clone(tipHolder),
  clone(orificePlate),
  clone(deflector),
  clone(sprinklerDriveSpindle),
  clone(sprinklerUpperBearing),
  clone(sprinklerLowerBearing),
  clone(sprinklerRotorHub),
  frontLeftRotorArms,
  frontLeftJets,
  frontLeftJetCaps
])
  |> rotate(axis = Z, angle = 130deg, global = true)
  |> translate(
       x = -nozzleX,
       y = -nozzleY,
       z = nozzleZ,
       global = true,
     )

rearRightRings = patternLinear3d(
  clone(barbRingSeed),
  instances = 4,
  distance = 9mm,
  axis = Z,
)
rearRightRotorArms = patternCircular3d(
  clone(sprinklerRotorArmSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
rearRightJets = patternCircular3d(
  clone(sprinklerJetSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
rearRightJetCaps = patternCircular3d(
  clone(sprinklerJetCapSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
rearRightNozzle = flatten([
  clone(valveBody),
  clone(inletBarb),
  rearRightRings,
  clone(strainerCup),
  clone(meshDisk),
  clone(tipHolder),
  clone(orificePlate),
  clone(deflector),
  clone(sprinklerDriveSpindle),
  clone(sprinklerUpperBearing),
  clone(sprinklerLowerBearing),
  clone(sprinklerRotorHub),
  rearRightRotorArms,
  rearRightJets,
  rearRightJetCaps
])
  |> rotate(axis = Z, angle = 250deg, global = true)
  |> translate(
       x = nozzleX,
       y = nozzleY,
       z = nozzleZ,
       global = true,
     )

rearLeftRings = patternLinear3d(
  clone(barbRingSeed),
  instances = 4,
  distance = 9mm,
  axis = Z,
)
rearLeftRotorArms = patternCircular3d(
  clone(sprinklerRotorArmSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
rearLeftJets = patternCircular3d(
  clone(sprinklerJetSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
rearLeftJetCaps = patternCircular3d(
  clone(sprinklerJetCapSeed),
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
rearLeftNozzle = flatten([
  clone(valveBody),
  clone(inletBarb),
  rearLeftRings,
  clone(strainerCup),
  clone(meshDisk),
  clone(tipHolder),
  clone(orificePlate),
  clone(deflector),
  clone(sprinklerDriveSpindle),
  clone(sprinklerUpperBearing),
  clone(sprinklerLowerBearing),
  clone(sprinklerRotorHub),
  rearLeftRotorArms,
  rearLeftJets,
  rearLeftJetCaps
])
  |> rotate(axis = Z, angle = 10deg, global = true)
  |> translate(
       x = -nozzleX,
       y = nozzleY,
       z = nozzleZ,
       global = true,
     )

export allBodies = flatten([
  frontRightNozzle,
  frontLeftNozzle,
  rearRightNozzle,
  rearLeftNozzle
])

hide(valveBody)
hide(inletBarb)
hide(barbRingSeed)
hide(strainerCup)
hide(meshDisk)
hide(tipHolder)
hide(orificePlate)
hide(deflector)
hide(sprinklerDriveSpindle)
hide(sprinklerUpperBearing)
hide(sprinklerLowerBearing)
hide(sprinklerRotorHub)
hide(sprinklerRotorArmSeed)
hide(sprinklerJetSeed)
hide(sprinklerJetCapSeed)

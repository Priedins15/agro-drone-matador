// Detailed navigation, GNSS, telemetry, and smart-antenna module
// Narrow canopy-mounted radio stack with GNSS/RTK layers, diversity whips, blade antennas, ports, and fasteners.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import unitBlock from "unitBlock.kcl"
import unitCylinder from "unitCylinder.kcl"
import unitSphere from "unitSphere.kcl"
import * from "parameters.kcl"


// Compact stabilized camera and gimbal module
// Layered optics with narrowed pitch drives, lighter fork arms, compact yaw stack, dampers, and service connections.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import unitBlock from "unitBlock.kcl"
import unitCylinder from "unitCylinder.kcl"
import * from "parameters.kcl"

cameraHousing = clone(unitBlock)
  |> scale(
       x = 50,
       y = 34,
       z = 36,
       global = false,
     )
  |> appearance(color = hardwareBlack, metalness = 36, roughness = 48)

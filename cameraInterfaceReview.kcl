// Camera-to-fuselage interface review
// Focused inspection aid for the relocated camera hardpoint and unobstructed gimbal envelope.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import allBodies as lowerShellSet from "lowerFuselageShell.kcl"
import allBodies as cameraSet from "cameraModule.kcl"

lowerFuselage = lowerShellSet
forwardCamera = cameraSet
  |> translate(y = -177mm, z = -78mm, global = true)

export allBodies = flatten([lowerFuselage, forwardCamera])

allBodies

// Anti-drip spray nozzle with curved driven sprinkler head
// Inlet barb, valve body, strainer envelope, tapered rotor arms, and adjustable nozzle inserts.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import unitBlock from "unitBlock.kcl"
import unitCylinder from "unitCylinder.kcl"
import * from "parameters.kcl"

valveBlank = clone(unitCylinder)
  |> scale(
       x = 30,
       y = 30,
       z = 52,
       global = false,
     )
valveBoreCutter = clone(unitCylinder)
  |> scale(
       x = 6,
       y = 6,
       z = 58,
       global = false,
     )
export valveBody = subtract(valveBlank, tools = [valveBoreCutter])
  |> translate(z = 12mm, global = true)
  |> appearance(color = hardwareBlack, metalness = 42, roughness = 46)
export inletBarb = clone(unitCylinder)
  |> scale(
       x = 14,
       y = 14,
       z = 44,
       global = false,
     )
  |> translate(z = 58mm, global = true)
  |> appearance(color = hardwareSteel, metalness = 74, roughness = 30)
export barbRingSeed = clone(unitCylinder)
  |> scale(
       x = 20,
       y = 20,
       z = 4,
       global = false,
     )
  |> translate(z = 46mm, global = true)
  |> appearance(color = hardwareSteel, metalness = 78, roughness = 28)
export barbRings = patternLinear3d(
  barbRingSeed,
  instances = 4,
  distance = 9mm,
  axis = Z,
)
export strainerCup = clone(unitCylinder)
  |> scale(
       x = 42,
       y = 42,
       z = 44,
       global = false,
     )
  |> translate(z = -36mm, global = true)
  |> appearance(
       color = "#d8e0df",
       metalness = 4,
       roughness = 42,
       opacity = 58,
     )
export meshDisk = clone(unitCylinder)
  |> scale(
       x = 33,
       y = 33,
       z = 2,
       global = false,
     )
  |> translate(z = -57mm, global = true)
  |> appearance(color = hardwareSteel, metalness = 64, roughness = 46)
tipHolderBlank = clone(unitCylinder)
  |> scale(
       x = 28,
       y = 28,
       z = 24,
       global = false,
     )
  |> translate(z = -70mm, global = true)
tipHolderBore = clone(unitCylinder)
  |> scale(
       x = 7,
       y = 7,
       z = 28,
       global = false,
     )
  |> translate(z = -70mm, global = true)
export tipHolder = subtract(tipHolderBlank, tools = [tipHolderBore])
  |> appearance(color = warningOrange, metalness = 12, roughness = 50)
orificePlateBlank = clone(unitCylinder)
  |> scale(
       x = 22,
       y = 22,
       z = 5,
       global = false,
     )
  |> translate(z = -84mm, global = true)
orificeCutter = clone(unitCylinder)
  |> scale(
       x = 1.8,
       y = 1.8,
       z = 9,
       global = false,
     )
  |> translate(z = -84mm, global = true)
export orificePlate = subtract(orificePlateBlank, tools = [orificeCutter])
  |> appearance(color = hardwareSteel, metalness = 82, roughness = 26)
export deflector = clone(unitBlock)
  |> scale(
       x = 30,
       y = 6,
       z = 4,
       global = false,
     )
  |> translate(z = -94mm, global = true)
  |> appearance(color = warningOrange, metalness = 10, roughness = 52)

// Rotary sprinkler drive stack. The spindle overlaps the deflector and hub so the rotor is not a floating detail.
export sprinklerDriveSpindle = clone(unitCylinder)
  |> scale(
       x = 6,
       y = 6,
       z = 24,
       global = false,
     )
  |> translate(z = -105mm, global = true)
  |> appearance(color = hardwareSteel, metalness = 88, roughness = 22)
export sprinklerUpperBearing = clone(unitCylinder)
  |> scale(
       x = 14,
       y = 14,
       z = 5,
       global = false,
     )
  |> translate(z = -100mm, global = true)
  |> appearance(color = hardwareBlack, metalness = 52, roughness = 38)
export sprinklerLowerBearing = clone(unitCylinder)
  |> scale(
       x = 16,
       y = 16,
       z = 5,
       global = false,
     )
  |> translate(z = -113mm, global = true)
  |> appearance(color = hardwareBlack, metalness = 52, roughness = 38)
rotorHubBlank = clone(unitCylinder)
  |> scale(
       x = 24,
       y = 24,
       z = 9,
       global = false,
     )
  |> translate(z = -119mm, global = true)
rotorHubBore = clone(unitCylinder)
  |> scale(
       x = 6.5,
       y = 6.5,
       z = 14,
       global = false,
     )
  |> translate(z = -119mm, global = true)
export sprinklerRotorHub = subtract(rotorHubBlank, tools = [rotorHubBore])
  |> appearance(color = hardwareBlack, metalness = 60, roughness = 34)

// Curved, tapered rotor arm profile. The outer arc bends the arm away from the hub;
// the drafted extrusion gives the arm a manufacturable taper through its thickness.
curvedArmRadius = 45mm
sprinklerArmProfile = sketch(on = XY) {
  outerArc = arc(start = [var 24mm, var 0mm], end = [var 69mm, var 45mm], center = [var 24mm, var 45mm])
  tipEdge = line(start = [var 69mm, var 45mm], end = [var 61mm, var 40mm])
  innerEdge = line(start = [var 61mm, var 40mm], end = [var 24mm, var 8mm])
  rootEdge = line(start = [var 24mm, var 8mm], end = [var 24mm, var 0mm])

  coincident([outerArc.end, tipEdge.start])
  coincident([tipEdge.end, innerEdge.start])
  coincident([innerEdge.end, rootEdge.start])
  coincident([rootEdge.end, outerArc.start])

  radius(outerArc) == curvedArmRadius
  horizontalDistance([ORIGIN, outerArc.center]) == 24mm
  verticalDistance([ORIGIN, outerArc.center]) == 45mm
  horizontalDistance([ORIGIN, outerArc.start]) == 24mm
  verticalDistance([ORIGIN, outerArc.start]) == 0mm
  horizontalDistance([ORIGIN, outerArc.end]) == 69mm
  verticalDistance([ORIGIN, outerArc.end]) == 45mm
  horizontalDistance([ORIGIN, tipEdge.end]) == 61mm
  verticalDistance([ORIGIN, tipEdge.end]) == 40mm
  horizontalDistance([ORIGIN, rootEdge.start]) == 24mm
  verticalDistance([ORIGIN, rootEdge.start]) == 8mm
  vertical(rootEdge)
}
sprinklerArmRegion = region(segments = [
  sprinklerArmProfile.outerArc,
  sprinklerArmProfile.tipEdge
])
export sprinklerRotorArmSeed = extrude(
  sprinklerArmRegion,
  length = 5mm,
  symmetric = true,
  draftAngle = 4deg,
  method = NEW,
)
  |> translate(z = -121mm, global = true)
  |> appearance(color = warningOrange, metalness = 18, roughness = 44)
export sprinklerRotorArms = patternCircular3d(
  sprinklerRotorArmSeed,
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)

// Solver-driven adjustable nozzle insert at the tapered arm tip.
adjustableInsertProfile = sketch(on = XY) {
  insertCircle = circle(start = [var 65mm, var 40mm], center = [var 61mm, var 40mm])
  horizontal([
    insertCircle.center,
    insertCircle.start
  ])
  horizontalDistance([ORIGIN, insertCircle.center]) == 61mm
  verticalDistance([ORIGIN, insertCircle.center]) == 40mm
  diameter(insertCircle) == 8mm
}
adjustableInsertRegion = region(segments = [adjustableInsertProfile.insertCircle])
export sprinklerJetSeed = extrude(
  adjustableInsertRegion,
  length = 8mm,
  symmetric = true,
  method = NEW,
)
  |> translate(z = -121mm, global = true)
  |> appearance(color = hardwareSteel, metalness = 82, roughness = 24)

adjustableCapProfile = sketch(on = XY) {
  capCircle = circle(start = [var 66mm, var 40mm], center = [var 61mm, var 40mm])
  horizontal([capCircle.center, capCircle.start])
  horizontalDistance([ORIGIN, capCircle.center]) == 61mm
  verticalDistance([ORIGIN, capCircle.center]) == 40mm
  diameter(capCircle) == 10mm
}
adjustableCapRegion = region(segments = [adjustableCapProfile.capCircle])
export sprinklerJetCapSeed = extrude(
  adjustableCapRegion,
  length = 3mm,
  symmetric = true,
  method = NEW,
)
  |> translate(z = -121mm, global = true)
  |> appearance(color = hardwareSteel, metalness = 86, roughness = 22)
export sprinklerJets = patternCircular3d(
  sprinklerJetSeed,
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)
export sprinklerJetCaps = patternCircular3d(
  sprinklerJetCapSeed,
  instances = 3,
  axis = Z,
  center = [0mm, 0mm, -121mm],
  arcDegrees = 360deg,
  rotateDuplicates = true,
)

// Tangential outlet body. Its 123-degree seed orientation follows the tangent at the 61-by-40-mm tip datum;
// the circular pattern preserves that tangential relationship around the rotor.
tangentialOutletAngle = 123deg
export sprinklerTangentialOutletSeed = clone(unitBlock)
  |> scale(
       x = 16,
       y = 6,
       z = 7,
       global = false,
     )
  |> rotate(axis = Z, angle = tangentialOutletAngle, global = true)
  |> translate(
       x = 68mm,
       y = 40mm,
       z = -121mm,
       global = true,
     )
  |> appearance(color = warningOrange, metalness = 22, roughness = 42)

// Transparent tapered bodies communicate the downward water path without changing the solid nozzle design.
sprayConeProfile = sketch(on = XY) {
  sprayCircle = circle(start = [var 64mm, var 40mm], center = [var 61mm, var 40mm])
  horizontal([sprayCircle.center, sprayCircle.start])
  horizontalDistance([ORIGIN, sprayCircle.center]) == 61mm
  verticalDistance([ORIGIN, sprayCircle.center]) == 40mm
  diameter(sprayCircle) == 6mm
}
sprayConeRegion = region(segments = [sprayConeProfile.sprayCircle])
export sprinklerSprayConeSeed = extrude(
  sprayConeRegion,
  length = 28mm,
  symmetric = true,
  draftAngle = 12deg,
  method = NEW,
)
  |> translate(z = -138mm, global = true)
  |> appearance(
       color = "#6ec8e7",
       metalness = 0,
       roughness = 18,
       opacity = 24,
     )

export allBodies = flatten([
  valveBody,
  inletBarb,
  barbRings,
  strainerCup,
  meshDisk,
  tipHolder,
  orificePlate,
  deflector,
  sprinklerDriveSpindle,
  sprinklerUpperBearing,
  sprinklerLowerBearing,
  sprinklerRotorHub,
  sprinklerRotorArms,
  sprinklerJets,
  sprinklerJetCaps
])

hiddenBarbRings = hide(barbRings)
hiddenSprinklerArmProfile = hide(sprinklerArmProfile)
hiddenAdjustableInsertProfile = hide(adjustableInsertProfile)
hiddenAdjustableCapProfile = hide(adjustableCapProfile)
hiddenSprinklerTangentialOutletSeed = hide(sprinklerTangentialOutletSeed)
hiddenSprayConeProfile = hide(sprayConeProfile)
hiddenSprinklerSprayConeSeed = hide(sprinklerSprayConeSeed)

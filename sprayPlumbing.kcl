// Clearance-routed spray plumbing harness
// Rear-mounted manifold, tank pickup, pump circuit, side trunks, arm feeds, elbows, and nozzle risers.
@settings(defaultLengthUnit = mm, kclVersion = 2.0)

import unitBlock from "unitBlock.kcl"
import unitCylinder from "unitCylinder.kcl"
import unitSphere from "unitSphere.kcl"
import * from "parameters.kcl"

centerManifold = clone(unitBlock)
